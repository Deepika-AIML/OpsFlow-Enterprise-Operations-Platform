# Copy this file to `.env` and adjust values as needed.
# `docker compose up --build` also works without a .env file at all -
# every value below has a safe local-dev default baked into
# docker-compose.yml. Create one only if you want to change something
# (e.g. use different demo passwords, or run manage.py on your host
# machine directly against the Dockerized MySQL).

# --- Django -----------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-local-dev-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (MySQL) ---------------------------------------------------
MYSQL_DATABASE=opsflow_db
MYSQL_USER=opsflow_user
MYSQL_PASSWORD=opsflow_password
MYSQL_ROOT_PASSWORD=opsflow_root_password
# Only needed if running manage.py directly on the host (outside Docker):
DB_HOST=localhost
DB_PORT=3306

# --- CORS (only matters if the frontend is ever served separately from
#     this API - the bundled docker-compose setup is same-origin) --------
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Demo accounts, created automatically on first `docker compose up` -
ADMIN_EMAIL=admin@opsflow.local
ADMIN_PASSWORD=Admin@12345
MANAGER_EMAIL=manager@opsflow.local
MANAGER_PASSWORD=Manager@12345
EMPLOYEE_EMAIL=employee@opsflow.local
EMPLOYEE_PASSWORD=Employee@12345
